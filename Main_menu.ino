void showStartupLogo() {
  u8g2.clearBuffer();
  
  // Get display dimensions
  int screenWidth = u8g2.getDisplayWidth();
  int screenHeight = u8g2.getDisplayHeight();
  
  // Calculate centered position
  int x = (screenWidth - LOGO_WIDTH) / 2;
  int y = (screenHeight - LOGO_HEIGHT) / 2;
  
  // Draw the bitmap at the calculated position
  u8g2.setDrawColor(1);
  u8g2.drawXBMP(x, y, LOGO_WIDTH, LOGO_HEIGHT, logo_data);
  u8g2.sendBuffer();
  
  delay(2000); // Display for 2 seconds
}


void setup() {
  Serial.begin(115200);
  u8g2.begin(); 
  u8g2.setContrast(150); 
  showStartupLogo();

  
  Serial.println("Setup started...");

  // Keep both SPI devices deselected while the SD card is initialized.
  pinMode(CC1101_CS, OUTPUT);
  digitalWrite(CC1101_CS, HIGH);
  pinMode(5, OUTPUT);
  digitalWrite(5, HIGH);

  // Initialize the radio before probing an optional SD device. A failed SD
  // probe can leave the shared SPI peripheral in an unusable state.
  InitSubGHz();
  delay(500);
  yield();

  // SD Card Init
  Serial.println("Initializing SD Card...");
  if (useSD) {
    if (!SD.begin(5)) {
      Serial.println("SD card not found.");
      useSD = false;
    } else {
      Serial.println("SD OK!");
      if (!SD.exists("/ir")) SD.mkdir("/ir");
      if (!SD.exists("/rfid")) SD.mkdir("/rfid");
      if (!SD.exists("/subghz")) SD.mkdir("/subghz");
    }
  }

  if (!subGhzRadioReady) {
    Serial.println("Retrying MD1101 after SD initialization...");
    InitSubGHz();
  }
  delay(500);
  yield();

  // Button Init
  pinMode(BUTTON_SELECT, INPUT_PULLUP);
  pinMode(BUTTON_BACK, INPUT_PULLUP);

  pinMode(ANALOG_BUTTONS_PIN, INPUT);
  delay(500);
  yield();

  // Other initialization functions ...
  Initnfc();
  delay(500);
  yield();

  InitIR();
  delay(500);
  yield();

  digitalWrite(CC1101_CS, HIGH);
  digitalWrite(5, HIGH);

  gameSetup();
  delay(500);
  yield();

  InitMarauder();
  delay(500);
  yield();

  Serial.println("Setup finished!");
}


bool marauderModeStarted = false;
bool bluetoothStarted = false;

void loop() {
  switch (currentMode) {
    case MENU:
      displayStartingMenu();
      handleMenuInput();
      break;
    case IR_MODE:
      displayIRMenu();
      HandlebuttonIR();
      break;
    case GAME_MODE:
      gameLoop();
      break;
    case SUBGHZ_MODE:
      displaySubGHzMenu();
      HanldeSubGHzbutton();
      break;
    case NFC_MODE:
      handleNFCMode();
      HandlebuttonNFC();
      break;
    case BLUETOOTH_MODE:
      if (!bluetoothStarted) {
        InitBluetooth();  // lazy start -- see note in setup()
      }
      handleBLEMode();
      HandlebuttonBLE();
      break;
    case MARAUDER_MODE:
      if (!marauderModeStarted) {
        InitMarauder();
        marauderModeStarted = true;
        targetFound = false;
      }
      handleMarauderMode();
      break;
    default:
      break;
  }
}


void handleMenuInput() {

  static int lastButton = -1;
  static int stableButton = -1;
  static unsigned long stateChangeTime = 0;

  int currentButton = -1;

  // ------------------------------------------------------------
  // Read which button is currently pressed
  // ------------------------------------------------------------

  if (readButton(BUTTON_LEFT) == LOW) {
    currentButton = BUTTON_LEFT;
  }
  else if (readButton(BUTTON_RIGHT) == LOW) {
    currentButton = BUTTON_RIGHT;
  }
  else if (readButton(BUTTON_UP) == LOW) {
    currentButton = BUTTON_UP;
  }
  else if (readButton(BUTTON_DOWN) == LOW) {
    currentButton = BUTTON_DOWN;
  }
  else if (readButton(BUTTON_SELECT) == LOW) {
    currentButton = BUTTON_SELECT;
  }
  else if (readButton(BUTTON_BACK) == LOW) {
    currentButton = BUTTON_BACK;
  }


  // ------------------------------------------------------------
  // Detect a change in button state
  // ------------------------------------------------------------

  if (currentButton != lastButton) {

    lastButton = currentButton;
    stateChangeTime = millis();

    return;
  }


  // ------------------------------------------------------------
  // Wait for the button state to remain stable
  // ------------------------------------------------------------

  if (millis() - stateChangeTime < 40) {
    return;
  }


  // ------------------------------------------------------------
  // Only execute when a NEW button press is detected
  // ------------------------------------------------------------

  if (currentButton != stableButton) {

    stableButton = currentButton;

    // Ignore release
    if (stableButton == -1) {
      return;
    }


    // ----------------------------------------------------------
    // LEFT
    // ----------------------------------------------------------

    if (stableButton == BUTTON_LEFT) {

      selectedOption--;

      if (selectedOption < 0) {
        selectedOption = 5;
      }

      Serial.println("BUTTON LEFT");
    }


    // ----------------------------------------------------------
    // RIGHT
    // ----------------------------------------------------------

    else if (stableButton == BUTTON_RIGHT) {

      selectedOption++;

      if (selectedOption > 5) {
        selectedOption = 0;
      }

      Serial.println("BUTTON RIGHT");
    }


    // ----------------------------------------------------------
    // UP
    // ----------------------------------------------------------

    else if (stableButton == BUTTON_UP) {

      Serial.println("BUTTON UP");
    }


    // ----------------------------------------------------------
    // DOWN
    // ----------------------------------------------------------

    else if (stableButton == BUTTON_DOWN) {

      Serial.println("BUTTON DOWN");
    }


    // ----------------------------------------------------------
    // SELECT
    // ----------------------------------------------------------

    else if (stableButton == BUTTON_SELECT) {

      Serial.println("BUTTON SELECT");

      selectOption();
    }


    // ----------------------------------------------------------
    // BACK
    // ----------------------------------------------------------

    else if (stableButton == BUTTON_BACK) {

      Serial.println("BUTTON BACK");

      currentMode = MENU;
    }
  }
}



void selectOption() {
  switch (selectedOption) {
    case 0: 
      currentMode = IR_MODE;  // Switch to IR Mode
      break;
    case 1: 
      selectSubGHzOption = 0;
      currentMode = SUBGHZ_MODE;  // Switch to SubGHz Mode
      break;
    case 2: 
      currentMode = NFC_MODE;  // Switch to NFC Mode
      break;
    case 3: 
      currentMode = GAME_MODE;  // Switch to Game Mode
      break;
    case 4: 
      currentMode = BLUETOOTH_MODE;  // Switch to Bluetooth Mode
      break;
    case 5: 
      currentMode = MARAUDER_MODE;  // Switch to Marauder Mode
      break;
    default: 
      break;
  }
}

void displayStartingMenu() {
  u8g2.clearBuffer();

  const char* menuOptions[] = {"IR Mode", "SubGHz", "NFC Mode", "Game Mode", "Bluetooth", "Marauder"};
  const unsigned char* modeIcons[] = {IR_ICON, SUBGHZ_ICON, NFC_ICON, GAME_ICON, BT_ICON, MARAUDER_ICON};
  int totalOptions = sizeof(menuOptions) / sizeof(menuOptions[0]);


  if (totalOptions == 0) {
    return;
  }

  if (selectedOption < 0 || selectedOption >= totalOptions) {
    selectedOption = 0;
  }

  if (modeIcons[selectedOption] == NULL) {
    return;
  }

  u8g2.drawXBMP((128 - 48) / 2, 5, 48, 48, modeIcons[selectedOption]);

  if (menuOptions[selectedOption] == NULL) {
    return;
  }

  u8g2.setFont(u8g2_font_squeezed_b6_tr);
  int textWidth = u8g2.getStrWidth(menuOptions[selectedOption]);

  if (textWidth == 0) {
    return;
  }

  u8g2.setCursor((128 - textWidth) / 2, 60);
  u8g2.print(menuOptions[selectedOption]);

  u8g2.sendBuffer();
}




void exitMode() {
  currentMode = MENU;
}
